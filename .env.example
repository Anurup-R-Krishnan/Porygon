# Copy this file to .env before starting the stack. Never commit .env.
COMPOSE_PROJECT_NAME=porygon

POSTGRES_DB=porygon
POSTGRES_USER=porygon
POSTGRES_PASSWORD=replace-with-a-long-local-development-password

BACKEND_PORT=8000
PORYGON_ENVIRONMENT=development
PORYGON_LOG_LEVEL=INFO

# Shared credential used only for service-to-service calls inside the Compose network.
PORYGON_INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters

# Separate credential for human/operator decisions. Automated services do not receive it.
PORYGON_OPERATOR_API_TOKEN=replace-with-a-different-32-character-random-token

# Exploratory calibrated rarity endpoints stay disabled until protocol review.
PORYGON_CALIBRATED_ENABLED=false

COLLECTOR_INSTANCE_ID=local-collector-01
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=10

TELEMETRY_INSTANCE_ID=local-falco-adapter-01
TELEMETRY_HEARTBEAT_INTERVAL_SECONDS=10

# Linux Docker socket. Replace DOCKER_GID with:
# stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=replace-with-docker-socket-gid

# Keep "auto" for the Docker collector. The backend resolves Falco's short
# container IDs against the collector's full container identity records.
PORYGON_DOCKER_HOST_ID=auto
PORYGON_DOCKER_TIMEOUT_SECONDS=10
PORYGON_DOCKER_EVENT_WINDOW_SECONDS=15
PORYGON_DOCKER_EVENT_OVERLAP_SECONDS=2
PORYGON_SPOOL_MAX_EVENTS=100000
PORYGON_DELIVERY_BATCH_SIZE=100
PORYGON_DELIVERY_POLL_SECONDS=1
PORYGON_DELIVERY_RETRY_MAX_SECONDS=60

# Falco JSON file tailing and process-event delivery.
PORYGON_FALCO_POLL_SECONDS=0.25
PORYGON_FALCO_MAX_LINE_BYTES=1048576
PORYGON_PROCESS_SPOOL_MAX_EVENTS=250000
PORYGON_PROCESS_DELIVERY_BATCH_SIZE=100
PORYGON_PROCESS_DELIVERY_POLL_SECONDS=1
PORYGON_PROCESS_DELIVERY_RETRY_MAX_SECONDS=60

# Malformed Falco records are diagnostics, not canonical evidence. Retain only
# redacted excerpts under simultaneous record, byte, and age limits.
PORYGON_DEAD_LETTER_MAX_RECORDS=1000
PORYGON_DEAD_LETTER_MAX_TOTAL_BYTES=1048576
PORYGON_DEAD_LETTER_EXCERPT_BYTES=512
PORYGON_DEAD_LETTER_RETENTION_SECONDS=604800

# Phase 4 synchronous baseline-build safety limits.
PORYGON_BASELINE_MAX_EVENTS=250000
PORYGON_BASELINE_MAX_WINDOWS=50000

# Phase 5 fixed-window scoring safety and evidence-sufficiency limits.
PORYGON_ANOMALY_MAX_EVENTS=100000
PORYGON_ANOMALY_MIN_PROCESS_EVENTS=1
PORYGON_PARENT_CORRELATION_LOOKBACK_SECONDS=600

# Safe default: disruptive approvals remain queued. Set this to "live" only
# for the explicit verify-response-live target in an isolated test environment.
PORYGON_RESPONSE_EXECUTION_MODE=disabled
PORYGON_RESPONSE_APPROVAL_MAX_AGE_SECONDS=3600

RESPONDER_INSTANCE_ID=local-responder-01
RESPONDER_HEARTBEAT_INTERVAL_SECONDS=10
PORYGON_RESPONSE_POLL_SECONDS=1
PORYGON_RESPONSE_LEASE_SECONDS=30
PORYGON_STOP_TIMEOUT_SECONDS=10

# Phase 8 digest-bound image scanner and enrichment worker.
SCANNER_INSTANCE_ID=local-trivy-scanner-01
SCANNER_HEARTBEAT_INTERVAL_SECONDS=10
PORYGON_SCANNER_POLL_SECONDS=2
PORYGON_SCANNER_LEASE_SECONDS=1800
PORYGON_TRIVY_VERSION=0.72.0
PORYGON_TRIVY_TIMEOUT_SECONDS=900
PORYGON_INTEL_TIMEOUT_SECONDS=30
PORYGON_INTEL_BATCH_SIZE=100
PORYGON_VULNERABILITY_MAX_FINDINGS=50000
PORYGON_VULNERABILITY_RUNTIME_EVENT_LIMIT=10000
PORYGON_SBOM_MAX_COMPONENTS=500000
